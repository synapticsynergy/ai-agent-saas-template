    "Itinerary": {
      "description": "The agent's working itinerary \u2014 shared UI/agent state.\n\nDistinct from ``PlanRead``: an itinerary exists only in the running agent\nsession and has no id or tenant until the user saves it. Modelling the\nin-progress plan separately keeps \"draft the agent is editing\" and \"record\nthe database owns\" from blurring together.",
      "properties": {
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "estimated_cost": {
          "default": 0.0,
          "minimum": 0,
          "title": "Estimated Cost",
          "type": "number"
        },
        "estimated_walk_distance_km": {
          "default": 0.0,
          "minimum": 0,
          "title": "Estimated Walk Distance Km",
          "type": "number"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set once the itinerary has been saved through the API.",
          "title": "Plan Id"
        },
        "saved": {
          "default": false,
          "title": "Saved",
          "type": "boolean"
        },
        "start_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/PlanStopCreate"
          },
          "maxItems": 20,
          "title": "Stops",
          "type": "array"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "Itinerary",
      "type": "object"
