# ---------------------------------------------------------------------------
# ai-agent-saas-template — example environment
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials. In a deployed
# environment set these in the host's own secret store (Vercel project env,
# Fly secrets, Render environment) rather than shipping a file.
#
# Nothing below needs changing to run locally. `make install && make infra-up
# && make dev` works as-is: authentication resolves a fixture identity, the
# agent makes no model call, and places and events come from a canned dataset.
# All three are refused outside APP_ENV=local.
#
# To use a real model, set AGENT_MODEL_PROVIDER=anthropic and ANTHROPIC_API_KEY.
# To deploy, see docs/DEPLOYMENT.md — the variables that matter there are
# DATABASE_URL, the WORKOS_* block, ANTHROPIC_API_KEY and MCP_ALLOWED_HOSTS.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# One of: local | dev | staging | prod
APP_ENV=local
LOG_LEVEL=INFO

NEXT_PUBLIC_APP_URL=http://localhost:3000

# CopilotKit sends anonymous usage telemetry by default. Opt out here.
COPILOTKIT_TELEMETRY_DISABLED=true

# CopilotKit's inspector adds a "View in Inspector" row to the chat for every
# tool call, which buries the assistant's reply. Set to 1 while debugging.
NEXT_PUBLIC_COPILOTKIT_INSPECTOR=0
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Comma-separated list of origins allowed to call the FastAPI service.
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# WORKOS
# ---------------------------------------------------------------------------
# Create a WorkOS *development* environment at https://dashboard.workos.com
# and set the AuthKit redirect URI to WORKOS_REDIRECT_URI below.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Must be at least 32 characters. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Local-only escape hatch. When AUTH_DEV_FIXTURE=1 *and* APP_ENV=local, the web
# app and API accept a deterministic fixture identity instead of a real WorkOS
# session. Both services refuse to start with this enabled outside APP_ENV=local,
# so defaulting it on here is safe: the guard is APP_ENV, not this flag.
#
# Set it to 0 and fill in WORKOS_* above to develop against real WorkOS.
AUTH_DEV_FIXTURE=1
AUTH_DEV_FIXTURE_TOKEN=local-dev-fixture-token
AUTH_DEV_FIXTURE_USER_ID=user_local_demo
AUTH_DEV_FIXTURE_ORG_ID=org_local_demo
AUTH_DEV_FIXTURE_EMAIL=demo@example.com
AUTH_DEV_FIXTURE_ROLE=member

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# One URL. The app derives the asyncpg and psycopg forms itself, so paste
# whatever your Postgres provider gives you.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# ---------------------------------------------------------------------------
# AGENT
# ---------------------------------------------------------------------------
# Base URL the Next.js CopilotKit runtime uses to reach the agent. The agent is
# mounted at /agent on the backend rather than being its own service (ADR-009),
# so this is the backend's origin plus that prefix.
#   local:  http://localhost:8000/agent
#   cloud:  https://<your-backend-host>/agent
AGENT_BASE_URL=http://localhost:8000/agent

# ---------------------------------------------------------------------------
# ANTHROPIC (Claude API, called directly)
# ---------------------------------------------------------------------------
# Create a key at https://platform.claude.com. Leave empty if you have run
# `ant auth login` or export ANTHROPIC_API_KEY in your shell instead.
ANTHROPIC_API_KEY=
# claude-opus-5 is the default. claude-sonnet-5 and claude-haiku-4-5 cost less
# per token; this agent's two model calls are short, so try them.
ANTHROPIC_MODEL_ID=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# MODEL PROVIDER
# ---------------------------------------------------------------------------
# Which model interprets requests and writes the assistant's replies.
#   anthropic — the Claude API directly (needs ANTHROPIC_API_KEY or `ant auth login`)
#   scripted  — no model call: rule-based parsing and composed replies
#
# Only interpretation and the reply text change. The planner, the tools, the
# streaming and the entire authorization path are the real ones in every mode;
# see docs/adr/ADR-007-deterministic-planner.md. "scripted" is refused outside
# APP_ENV=local.
AGENT_MODEL_PROVIDER=scripted

# ---------------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------------
# Streamable-HTTP endpoint of the MCP server, mounted at /mcp on the backend.
# This is also the URL to give an external MCP client such as Claude Desktop.
MCP_SERVER_URL=http://localhost:8000/mcp

# Host headers the MCP transport accepts — DNS-rebinding protection. Any Host
# not listed is answered 421, so a deployed backend MUST name its own public
# hostname here or every MCP client is refused. Comma-separated, host[:port],
# no scheme. Configuration refuses to start outside APP_ENV=local without it.
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000,testserver

# ---------------------------------------------------------------------------
# MAPS
# ---------------------------------------------------------------------------
# Leaflet raster tiles.
#
# The default is OpenStreetMap's public tile server. It needs no key and is
# fine for local development, but its usage policy forbids production traffic —
# point these at your own provider (MapTiler, Stadia, Thunderforest, a self-
# hosted renderer) before deploying. Commercial providers carry the API key in
# the tile URL, which is why there is no separate key variable.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# ---------------------------------------------------------------------------
# EVENTS / PLACES PROVIDERS
# ---------------------------------------------------------------------------
# Provider selection for the reference application's data adapters.
#   fixture — deterministic local dataset (default; used by all automated tests)
#   http    — real provider behind PLACES_API_URL / EVENTS_API_URL
PLACES_PROVIDER=fixture
EVENTS_PROVIDER=fixture
ROUTE_PROVIDER=fixture

PLACES_API_URL=
PLACES_API_KEY=
EVENTS_API_URL=
EVENTS_API_KEY=
PROVIDER_TIMEOUT_SECONDS=8

# Default search origin when the browser does not supply a location.
# The reference app always sends location explicitly; this is only a fallback.
DEFAULT_LATITUDE=45.5231
DEFAULT_LONGITUDE=-122.6765
DEFAULT_TIMEZONE=America/Los_Angeles
