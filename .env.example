# ---------------------------------------------------------------------------
# ai-agent-saas-template — example environment
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# Cloud environments should source these from AWS SSM Parameter Store /
# Secrets Manager rather than a .env file (see docs/DEPLOYMENT.md).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# One of: local | dev | staging | prod
APP_ENV=local
LOG_LEVEL=INFO

NEXT_PUBLIC_APP_URL=http://localhost:3000

# CopilotKit sends anonymous usage telemetry by default. Opt out here.
COPILOTKIT_TELEMETRY_DISABLED=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Comma-separated list of origins allowed to call the FastAPI service.
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# WORKOS
# ---------------------------------------------------------------------------
# Create a WorkOS *development* environment at https://dashboard.workos.com
# and set the AuthKit redirect URI to WORKOS_REDIRECT_URI below.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Must be at least 32 characters. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Local-only escape hatch. When AUTH_DEV_FIXTURE=1 *and* APP_ENV=local, the web
# app and API accept a deterministic fixture identity instead of a real WorkOS
# session. Both services refuse to start with this enabled outside APP_ENV=local,
# so defaulting it on here is safe: the guard is APP_ENV, not this flag.
#
# Set it to 0 and fill in WORKOS_* above to develop against real WorkOS.
AUTH_DEV_FIXTURE=1
AUTH_DEV_FIXTURE_TOKEN=local-dev-fixture-token
AUTH_DEV_FIXTURE_USER_ID=user_local_demo
AUTH_DEV_FIXTURE_ORG_ID=org_local_demo
AUTH_DEV_FIXTURE_EMAIL=demo@example.com
AUTH_DEV_FIXTURE_ROLE=member

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Point conventional AWS SDK traffic at LocalStack locally. Leave EMPTY in
# dev/staging/prod so the SDK resolves real AWS endpoints.
AWS_ENDPOINT_URL=http://localhost:4566

S3_BUCKET=ai-agent-saas-local
# Optional DynamoDB adapter. Enable only if an access pattern needs it.
DYNAMODB_ENABLED=0
DYNAMODB_TABLE=ai-agent-saas-local

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Async driver for the application, sync driver for Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# ---------------------------------------------------------------------------
# AGENTCORE
# ---------------------------------------------------------------------------
# Base URL the Next.js CopilotKit runtime uses to reach the agent.
#   local:  http://localhost:8080  (agentcore dev, or the uvicorn fallback)
#   cloud:  the AgentCore Runtime invocation endpoint
#
# AgentCore Runtime resources themselves are configured by the AgentCore CLI,
# not here — see docs/adr/ADR-006-agentcore-owns-its-own-resources.md.
AGENT_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# BEDROCK
# ---------------------------------------------------------------------------
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-west-2
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.3

# How the agent interprets a request.
#   bedrock  — the real model (needs AWS credentials and Bedrock access)
#   scripted — rule-based parsing, no model call
#
# "scripted" affects request *interpretation* only. The planner, the tools, the
# streaming and the entire authorization path are the real ones either way; see
# docs/adr/ADR-007-deterministic-planner.md. Refused outside APP_ENV=local.
AGENT_MODEL_PROVIDER=scripted

# ---------------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8090
# Streamable-HTTP endpoint of the custom MCP server.
MCP_SERVER_URL=http://localhost:8090/mcp
# Set to an AgentCore Gateway MCP URL to route tools through the Gateway
# instead of the local MCP server. Leave empty to use MCP_SERVER_URL.
AGENTCORE_GATEWAY_URL=

# ---------------------------------------------------------------------------
# MAPS
# ---------------------------------------------------------------------------
# MapLibre style URL. The default is a keyless demo style suitable for local
# development only; point this at your own tile provider for dev/staging/prod.
# Commercial providers carry the API key inside the style URL, which is why
# there is no separate key variable here.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ---------------------------------------------------------------------------
# EVENTS / PLACES PROVIDERS
# ---------------------------------------------------------------------------
# Provider selection for the reference application's data adapters.
#   fixture — deterministic local dataset (default; used by all automated tests)
#   http    — real provider behind PLACES_API_URL / EVENTS_API_URL
PLACES_PROVIDER=fixture
EVENTS_PROVIDER=fixture
ROUTE_PROVIDER=fixture

PLACES_API_URL=
PLACES_API_KEY=
EVENTS_API_URL=
EVENTS_API_KEY=
PROVIDER_TIMEOUT_SECONDS=8

# Default search origin when the browser does not supply a location.
# The reference app always sends location explicitly; this is only a fallback.
DEFAULT_LATITUDE=45.5231
DEFAULT_LONGITUDE=-122.6765
DEFAULT_TIMEZONE=America/Los_Angeles
